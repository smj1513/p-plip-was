<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pplip.domain.user.persistence.dao.UserDao">



    <select id="findById" resultType="com.pplip.domain.user.persistence.entity.User">
        select
            id,
            name,
            birth
        from user
        where id = #{id};
    </select>

    <insert id="insert" parameterType="com.pplip.domain.user.persistence.entity.User" useGeneratedKeys="true" keyProperty="id">
        insert into user (name, birth)
        values (#{name}, #{birth});
    </insert>

    <update id="update" parameterType="com.pplip.domain.user.persistence.entity.User">
        update user
        <set>
            <if test="name != null">
                name = #{name},
            </if>
            <if test="birth != null">
                birth = #{birth},
            </if>
        </set>
        where id = #{id};
    </update>

    <delete id="delete">
        delete from user where id = #{id};
    </delete>


</mapper>